# --- App (runtime) ---
# Connection string for the SELECT-ONLY role (readonly_user). Never use an admin URL here.
DATABASE_URL=postgresql://readonly_user:change-me@localhost:5432/shop
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5
MAX_ROWS=500
STATEMENT_TIMEOUT_MS=5000
RATE_LIMIT_PER_MIN=20

# --- Seeding only (admin; used once by `python -m db.seed`) ---
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shop
READONLY_PASSWORD=change-me
